{
  "name": "procurement-data-scrapers",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test open-only/tests/*.test.cjs open-only/master/*.test.cjs master/test/*.test.cjs daily/test/*.test.cjs",
    "procurement:refresh": "node --use-system-ca --max-old-space-size=8192 daily/daily.cjs --publish",
    "test:coordinator": "node --test orchestration/test/*.test.cjs",
    "procurement:update": "node --use-system-ca --max-old-space-size=8192 daily/daily.cjs --publish",
    "procurement:verify": "node master/verify.cjs",
    "test:master": "node --test master/test/*.test.cjs",
    "test:daily": "node --test daily/test/*.test.cjs",
    "procurement:daily": "node --use-system-ca --max-old-space-size=8192 daily/daily.cjs --publish"
  },
  "dependencies": {
    "axios": "1.19.0",
    "cheerio": "1.2.0",
    "exceljs": "4.4.0",
    "pdf-parse": "1.1.1"
  }
}
