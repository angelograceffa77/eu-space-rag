{
  "name": "procurement-data-scrapers",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node validate-scrapers.cjs && npm --prefix EU27/National-Portals test",
    "test:expanded": "node validate-expanded-scrapers.cjs",
    "procurement:refresh": "node refresh-procurement.cjs",
    "procurement:list": "node refresh-procurement.cjs --list",
    "test:coordinator": "node --test orchestration/test/*.test.cjs",
    "procurement:master": "node --max-old-space-size=8192 build-procurement-master.cjs",
    "procurement:update": "node --max-old-space-size=8192 update-procurement.cjs",
    "procurement:verify": "node master/verify.cjs",
    "test:master": "node --test master/test/*.test.cjs"
  },
  "dependencies": {
    "axios": "1.19.0",
    "cheerio": "1.2.0",
    "exceljs": "4.4.0",
    "pdf-parse": "1.1.1"
  }
}
